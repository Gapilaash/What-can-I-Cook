# Copy this file to `.env` (same folder) for local development.
# On Vercel, set these in Project Settings -> Environment Variables instead. Never commit .env.

# --- AI features (free key: https://aistudio.google.com/apikey) ---
# Powers photo ingredient detection, "How to Cook?" AI recipes, swaps and nutrition.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# If the main model is overloaded (503 "high demand"), these are tried in order.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# --- Google Sign-In (free, see console.cloud.google.com -> APIs & Services -> Credentials) ---
# Create an OAuth Client ID (type "Web application"), add your site origin under
# "Authorized JavaScript origins" (e.g. http://localhost:8000), and paste the Client ID below.
# Leave empty to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# --- Email verification (real emails, no Google Cloud Console needed) ---
# Uses plain SMTP. Easiest free option is Gmail with an "App Password"
# (generated at myaccount.google.com/apppasswords, NOT Cloud Console - needs
# 2-Step Verification turned on first). Any SMTP provider works: just change
# SMTP_HOST/SMTP_PORT. Leave blank to skip sending and just log the
# verification link to the server console (fine for local dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
# Public URL of this app - used to build the link inside the verification email.
# Change to your real domain (e.g. https://your-app.vercel.app) in production.
APP_BASE_URL=http://localhost:8000

# --- Database ---
# Leave empty locally: the app uses a SQLite file (backend/app.db).
# REQUIRED on Vercel: a Postgres connection string, e.g. from a free Neon database.
# Use Neon's "pooled" connection string (host contains "-pooler"), ending in ?sslmode=require
DATABASE_URL=
